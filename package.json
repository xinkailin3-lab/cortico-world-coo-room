{
  "name": "cortico-world-coo-room",
  "version": "1.1.0",
  "description": "Coopanion / Cortico 3D 二次元两人套间扩展（轻量程序化几何版）：动静分离 6 功能区 + 5 扇可开关实体门 + 人与桌宠真实移动与开门过程 + 家具墙体碰撞箱与防卡门保护。",
  "author": "xinkailin3-lab",
  "license": "MIT",
  "type": "module",
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinkailin3-lab/cortico-world-coo-room.git"
  },
  "homepage": "https://github.com/xinkailin3-lab/cortico-world-coo-room#readme",
  "bugs": {
    "url": "https://github.com/xinkailin3-lab/cortico-world-coo-room/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "client.js",
    "standalone.js",
    "ENV_PROMPT.md",
    "describe.json",
    "lib",
    "web",
    "tools",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "desktop-pet",
    "3d-room",
    "anime"
  ],
  "scripts": {
    "standalone": "node standalone.js",
    "test": "node tools/smoke-test.mjs",
    "install:coopanion": "node tools/install-coopanion.mjs"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "二次元3D公寓",
    "webUiClient": "client.js",
    "describe": "describe.json",
    "tags": [
      "companion"
    ],
    "locales": {
      "zh": {
        "displayName": "二次元3D公寓",
        "description": "轻量程序化几何版二次元 3D 两人套间，支持可旋转上帝视角与室内视角、5 扇实体门开关过程、碰撞防卡门与当前 2D 桌宠模型同步。"
      },
      "en": {
        "displayName": "Anime 3D Apartment",
        "description": "Lightweight procedural anime 3D apartment for 2 with rotatable cutaway and indoor views, 5 interactive doors with anti-stuck collision, active 2D figure sync, and day-night cycle."
      }
    }
  }
}
